{
  "name": "angular-slot-game",
  "version": "1.0.0",
  "description": "Reactive Angular mini-game built with NgRx, RxJS and configurable real-time gameplay.",
  "private": true,
  "homepage": "https://krasny-lis.github.io/game/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Krasny-Lis/game.git"
  },
  "keywords": [
    "angular",
    "typescript",
    "ngrx",
    "rxjs",
    "browser-game",
    "github-pages"
  ],
  "scripts": {
    "start": "ng serve --open",
    "build": "ng build",
    "build:pages": "ng build --configuration production --base-href /game/",
    "test:pages": "node --test scripts/pages.test.mjs",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@ngrx/effects": "^17.2.0",
    "@ngrx/store": "^17.2.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.2",
    "zone.js": "^0.14.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.0",
    "@angular/cli": "^17.3.0",
    "@angular/compiler-cli": "^17.3.0",
    "@angular-eslint/builder": "^17.3.0",
    "@angular-eslint/eslint-plugin": "^17.3.0",
    "@angular-eslint/eslint-plugin-template": "^17.3.0",
    "@angular-eslint/schematics": "^17.3.0",
    "@angular-eslint/template-parser": "^17.3.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "typescript": "~5.2.0"
  }
}
